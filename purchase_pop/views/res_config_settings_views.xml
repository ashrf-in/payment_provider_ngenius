<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_pop" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.pop</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Point of Purchase" string="Point of Purchase" name="purchase_pop" groups="purchase.group_purchase_manager">
                    <h2>Terminal Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Allowed Master Categories</span>
                                <div class="text-muted">
                                    Tick the master categories whose child categories should appear in the POS Terminal. Leave blank to show all.
                                </div>
                                <div class="content-group mt16">
                                    <field name="pop_category_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
