<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Client action for the OWL POP terminal ── -->
    <record id="purchase_pop_action" model="ir.actions.client">
        <field name="name">Point of Purchase</field>
        <field name="tag">purchase_pop_action</field>
        <field name="target">main</field>
    </record>

    <!-- ── Window action to list/view POP orders ── -->
    <record id="purchase_pop_order_action" model="ir.actions.act_window">
        <field name="name">POP Orders</field>
        <field name="res_model">purchase.pop.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

    <!-- ── List view ── -->
    <record id="purchase_pop_order_view_list" model="ir.ui.view">
        <field name="name">purchase.pop.order.list</field>
        <field name="model">purchase.pop.order</field>
        <field name="arch" type="xml">
            <list string="POP Orders" create="false" decoration-muted="state == 'cancel'"
                  decoration-success="state == 'confirmed'">
                                <button name="action_print_receipt_order"
                                                string="Print Receipt"
                                                type="object"
                                                icon="fa-print"
                                                invisible="not purchase_order_id"/>
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="line_count" string="# Lines"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancel'"/>
                <field name="purchase_order_id"/>
                <field name="amount_total" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Search view ── -->
    <record id="purchase_pop_order_view_search" model="ir.ui.view">
        <field name="name">purchase.pop.order.search</field>
        <field name="model">purchase.pop.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purchase_order_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state','=','cancel')]"/>
                <separator/>
                <group>
                    <filter name="by_vendor" string="Vendor" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="by_date" string="Month" domain="[]" context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Form view ── -->
    <record id="purchase_pop_order_view_form" model="ir.ui.view">
        <field name="name">purchase.pop.order.form</field>
        <field name="model">purchase.pop.order</field>
        <field name="arch" type="xml">
            <form string="POP Order" create="false">
                <header>
                    <button name="action_open_purchase_order"
                            string="Open Purchase Order"
                            type="object"
                            class="btn-primary"
                            invisible="not purchase_order_id"/>
                    <button name="action_print_receipt_order"
                        string="Print Receipt"
                        type="object"
                        class="btn-secondary"
                        invisible="not purchase_order_id"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('confirmed', 'cancel')"
                            confirm="Cancel this POP order?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="date_order" readonly="1"/>
                            <field name="currency_id" readonly="1" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="amount_total" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" readonly="1" placeholder="No internal note."/>
                    <field name="order_line_ids" nolabel="1">
                        <list string="POP Lines" create="false" delete="false">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="purchase_line_id" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Menus ── -->
    <menuitem id="menu_purchase_pop_root"
              name="Point of Purchase"
              sequence="35"
              web_icon="purchase_pop,static/description/icon.svg"
              groups="purchase.group_purchase_user,purchase.group_purchase_manager"/>
    <menuitem id="menu_purchase_pop_terminal"
              name="Terminal"
              parent="menu_purchase_pop_root"
              action="purchase_pop_action"
              sequence="1"
              groups="purchase.group_purchase_user,purchase.group_purchase_manager"/>
    <menuitem id="menu_purchase_pop_orders"
              name="Orders"
              parent="menu_purchase_pop_root"
              action="purchase_pop_order_action"
              sequence="10"
              groups="purchase.group_purchase_user,purchase.group_purchase_manager"/>
    <menuitem id="menu_purchase_pop_configuration"
              name="Configuration"
              parent="menu_purchase_pop_root"
              sequence="100"
              groups="purchase.group_purchase_manager"/>

    <record id="action_purchase_pop_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'purchase_pop', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_purchase_pop_settings"
              name="Settings"
              parent="menu_purchase_pop_configuration"
              sequence="10"
              action="action_purchase_pop_configuration"
              groups="purchase.group_purchase_manager"/>
</odoo>
