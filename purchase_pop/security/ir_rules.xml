<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_pop_order_company_rule" model="ir.rule">
        <field name="name">POP Order: multi-company</field>
        <field name="model_id" ref="model_purchase_pop_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="purchase_pop_order_line_company_rule" model="ir.rule">
        <field name="name">POP Order Line: multi-company</field>
        <field name="model_id" ref="model_purchase_pop_order_line"/>
        <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
