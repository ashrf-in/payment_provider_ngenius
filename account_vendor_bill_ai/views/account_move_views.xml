<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_vendor_bill_ai" model="ir.ui.view">
        <field name="name">account.move.form.vendor.bill.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_vendor_bill_ai_parse"
                        type="object"
                        string="Parse with AI"
                        class="oe_highlight"
                        invisible="not vendor_bill_ai_can_parse"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="vendor_bill_ai_can_parse" invisible="1"/>
                <field name="vendor_bill_ai_state" invisible="1"/>
                <field name="vendor_bill_ai_message" invisible="1"/>
                <field name="vendor_bill_ai_confidence" invisible="1"/>
                <div class="alert alert-info"
                     role="status"
                     invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt') or vendor_bill_ai_state not in ('queued', 'processing')">
                    <span invisible="vendor_bill_ai_state != 'queued'">Vendor Bill AI parsing has been queued.</span>
                    <span invisible="vendor_bill_ai_state != 'processing'">Vendor Bill AI parsing is in progress.</span>
                </div>
                <div class="alert alert-warning"
                     role="alert"
                     invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt') or vendor_bill_ai_state != 'warning'">
                    <strong>Vendor Bill AI Warning</strong>
                    <div class="mt-2">
                        <field name="vendor_bill_ai_message" nolabel="1" readonly="1"/>
                    </div>
                </div>
                <div class="alert alert-danger"
                     role="alert"
                     invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt') or vendor_bill_ai_state != 'error'">
                    <strong>Vendor Bill AI Failed</strong>
                    <div class="mt-2">
                        <field name="vendor_bill_ai_message" nolabel="1" readonly="1"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="after">
                <group string="AI Parsing"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')">
                    <field name="vendor_bill_ai_state" readonly="1"/>
                    <field name="vendor_bill_ai_confidence" readonly="1"/>
                    <field name="vendor_bill_ai_last_run" readonly="1"/>
                    <field name="vendor_bill_ai_message" readonly="1"/>
                    <field name="vendor_bill_ai_attachment_checksum" groups="base.group_no_one" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_server_vendor_bill_ai_parse" model="ir.actions.server">
        <field name="name">Parse Vendor Bills with AI</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_vendor_bill_ai_parse_batch()
        </field>
    </record>
</odoo>